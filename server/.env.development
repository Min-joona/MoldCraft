# ─────────────────────────────────────────────────────────────
#  DEVELOPMENT .env  — copy this to .env to run locally
#  Works out of the box with a local MongoDB installation.
#  Email and image uploads are skipped (logged to terminal).
# ─────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# Uses local MongoDB — no account needed.
# Install MongoDB Community: https://www.mongodb.com/try/download/community
# Then start it: `brew services start mongodb-community` (Mac)
#                `net start MongoDB`                     (Windows)
MONGODB_URI=mongodb://127.0.0.1:27017/moldcraft

# JWT — any random string works for local dev
JWT_SECRET=local_dev_secret_change_in_production_abc123
JWT_EXPIRES_IN=7d

# ── OPTIONAL in dev (app runs fine without these) ────────────

# Cloudinary — leave blank in dev, uploads show placeholder image
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Email — leave blank in dev, emails are printed to terminal instead
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_FROM=MoldCraft <your@email.com>
# ADMIN_EMAIL=your@email.com

CLIENT_URL=http://localhost:5173
